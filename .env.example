# Stripe Sandbox / Test mode
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PRICE_PLUS_MONTHLY=price_your_plus_monthly_price
STRIPE_PRICE_PREMIUM_MONTHLY=price_your_premium_monthly_price
